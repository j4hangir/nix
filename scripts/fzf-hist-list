#!/bin/sh
# Print commands from zsh $HISTFILE (EXTENDED_HISTORY format),
# most recent first, deduplicated. Multi-line commands (lines ending
# with `\`) are joined into a single row for display. Used by
# fzf-history.zsh. Read-only — does not mutate $HISTFILE.
: "${HISTFILE:=$HOME/.zsh_history}"
[ -f "$HISTFILE" ] || exit 0
# LC_ALL=C: history files often contain stray bytes from paste / terminal
# escapes — forcing bytewise processing keeps awk from aborting on them.
LC_ALL=C awk '
  /^: [0-9]+:[0-9]+;/ {
    cmd = $0
    sub(/^[^;]*;/, "", cmd)
    n = 1
    while (cmd ~ /\\$/ && n < 100) {
      sub(/\\$/, "", cmd)
      if ((getline line) <= 0) break
      cmd = cmd " " line
      n++
    }
    print cmd
  }
' "$HISTFILE" \
  | LC_ALL=C awk '{a[NR]=$0} END {for (i=NR; i>0; i--) print a[i]}' \
  | LC_ALL=C awk '!seen[$0]++'
