#!/bin/sh
# Print "$1: $2" (or just "$1" if $2 empty) as an fzf header.
# If fzf is running with --listen, schedule a background clear of the
# header NOTIFY_SECS later so the message isn't sticky.
#
# Per-port generation file: each notify writes a new random gen. The
# backgrounded clearer captures its gen and skips if a later notify
# has superseded it — so press #1's 5s clear can't wipe press #2's
# fresh message.
NOTIFY_SECS=5
prefix="$1"
content="$2"
[ -z "$prefix" ] && exit 0

if [ -n "$content" ]; then
  msg="$prefix: $content"
else
  msg="$prefix"
fi

if [ -n "$FZF_PORT" ]; then
  gen_file="${TMPDIR:-/tmp}/fzf_hist_hdr_gen.$FZF_PORT"
  gen=$(od -An -vN8 -tx1 </dev/urandom 2>/dev/null | tr -d ' \n')
  [ -z "$gen" ] && gen="$$-$(date +%s)"
  printf '%s\n' "$gen" > "$gen_file"
  (
    sleep "$NOTIFY_SECS"
    current=$(cat "$gen_file" 2>/dev/null)
    [ "$current" = "$gen" ] || exit 0
    curl -sf -m 1 -X POST "localhost:$FZF_PORT" -d 'change-header()' >/dev/null 2>&1
  ) </dev/null >/dev/null 2>&1 &
fi

printf '%s' "$msg"
