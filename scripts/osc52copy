#!/bin/sh
# Copy stdin to system clipboard via OSC 52, wrapped in DCS for tmux passthrough
data=$(base64 | tr -d "\n")
if [ -n "$TMUX" ]; then
  # Get the tmux client TTY and write directly to it
  client_tty=$(tmux display-message -p '#{client_tty}')
  printf '\033Ptmux;\033\033]52;c;%s\a\033\\' "$data" > "$client_tty"
else
  printf '\033]52;c;%s\a' "$data" > /dev/tty
fi
