#!/usr/bin/env bash
# tmnt-trigger — called by iTerm2 trigger, opens a new tab with tmnt-mount
# iTerm2 trigger setup:
#   Regex:   \[tmnt:(.+)\]
#   Action:  Run Command
#   Command: $HOME/.nix/scripts/tmnt-trigger \1

remote="$1"

# strict validation: user@host:/path only
if [[ ! "$remote" =~ ^[a-zA-Z0-9._-]+@[a-zA-Z0-9._-]+:/.+$ ]]; then
  exit 1
fi

# debounce: ignore re-triggers for same request within 30s
lockfile="/tmp/tmnt-trigger.lock"
now=$(date +%s)
if [[ -f "$lockfile" ]]; then
  last_remote=$(head -1 "$lockfile")
  last_time=$(tail -1 "$lockfile")
  if [[ "$last_remote" == "$remote" && $((now - last_time)) -lt 30 ]]; then
    exit 0
  fi
fi
printf '%s\n%s\n' "$remote" "$now" > "$lockfile"

osascript - "$remote" <<'APPLESCRIPT'
on run argv
  set r to item 1 of argv
  tell application "iTerm2"
    tell current window
      create tab with default profile command ("tmnt-mount " & quoted form of r)
    end tell
  end tell
end run
APPLESCRIPT
